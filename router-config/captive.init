#!/bin/sh /etc/rc.common
# Captive Portal Service
# Runs on port 80 — intercepts connectivity checks

START=98
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command python3 /root/captive_check.py
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
