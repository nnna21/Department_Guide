#!/bin/sh /etc/rc.common
# Department Guide System — Flask Web App Service
# Auto-starts on router boot via procd

START=99
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command python3 /root/Router_Project/app.py
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
